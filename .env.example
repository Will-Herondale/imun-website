# =============================================================================
# IEMUN — Indian Model United Nations
# Environment configuration
# Copy this file to `.env.local` for local development and adjust values.
# NEVER commit `.env.local`. In Azure App Service, set these as application
# settings instead (see README).
# =============================================================================

# --- Public site configuration ---------------------------------------------
# Absolute URL of the public site. Used for canonical URLs, sitemap and
# Open Graph metadata. Replace with the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.iemun.example

# --- Registration control ---------------------------------------------------
# Master switch for delegate registration. Overrides siteConfig.registrationOpen.
# Use "true" or "false". Keep closed until you are ready to take registrations.
REGISTRATION_OPEN=false

# --- Admin access (organisers only) -----------------------------------------
# Credentials for the protected organisers' dashboard (/admin).
# ADMIN_PASSWORD is compared against the provided value on the server using a
# timing-safe comparison. Choose a long, unique passphrase and rotate it.
# Replace with Entra ID / App Service Authentication before large-scale use
# (see README -> Security considerations).
ADMIN_EMAIL=organisers@iemun.example
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
# Random 32+ character secret used to sign admin session cookies.
ADMIN_SESSION_SECRET=replace-with-64-random-characters

# --- Azure Table Storage (registration database) ----------------------------
# Production uses Azure Managed Identity. The App Service system-assigned
# identity must have the "Storage Table Data Contributor" role on the storage
# account. The table endpoint is derived from AZURE_STORAGE_ACCOUNT unless
# AZURE_TABLE_ACCOUNT_ENDPOINT is provided.
AZURE_STORAGE_ACCOUNT=iemunreg

# Optional: explicit table service endpoint (e.g. for sovereign clouds).
# AZURE_TABLE_ACCOUNT_ENDPOINT=https://iemunreg.table.core.windows.net

# Optional: alternate connection string (local emulator / dev fallback).
# Set to "UseDevelopmentStorage=true" when running against the Azurite
# emulator, or paste a storage account connection string for quick local dev.
# AZURE_TABLE_CONNECTION_STRING=

# Optional: table name override.
# AZURE_TABLE_NAME=registrations

# --- Registration database: Postgres (Neon) ---------------------------------
# Production on Netlify. The Postgres driver is selected automatically when one
# of these is set (it takes precedence over Azure Table Storage). Netlify's Neon
# integration injects NETLIFY_DATABASE_URL for you; DATABASE_URL is the generic
# fallback used by Vercel/Neon scripts.
# NETLIFY_DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional: force a specific driver ("postgres" or "azure") regardless of the
# presence of a connection string. Defaults to postgres when a URL is set,
# otherwise azure.
# STORAGE_DRIVER=postgres

# --- Local development -------------------------------------------------------
# Set to "true" to allow anonymous local admin login using ADMIN_EMAIL /
# ADMIN_PASSWORD from this file. Never set this in production.
# ALLOW_LOCAL_ADMIN=true